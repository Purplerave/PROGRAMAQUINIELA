diff --git a/tests/test_j2_programa.py b/tests/test_j2_programa.py
new file mode 100644
index 0000000..160f3e8
--- /dev/null
+++ b/tests/test_j2_programa.py
@@ -0,0 +1,87 @@
+"""Acceptance: boleto del PROGRAMA en la J2 (temporada 2026-2027).
+
+Contrato:
+- `data/predicciones_J2.json` es la salida del motor de PROGRAMAQUINIELA
+  (3 dobles = 8 columnas = 6,00 EUR, Pleno al 15 aparte).
+- `ensure_jornada_2()` carga esos 15 signos en `predicciones` como 'programa'.
+- Volver a ejecutar la migracion no duplica ni cambia nada (idempotente).
+- `/api/liga/data?j=2` devuelve el boleto y sus 15 motivos.
+"""
+
+import json
+import sqlite3
+
+import config
+from liga_maestros.db.migrations import (
+    _import_programa_ticket,
+    ensure_core_tables,
+    ensure_jornada_2,
+    ensure_predicciones_unique_index,
+)
+
+PROGRAMA_J2 = ["1", "1", "2", "1X", "2", "1", "12", "1", "2", "1", "1X", "1", "1", "2", "1-1"]
+
+
+def test_fichero_j2_trae_el_boleto_del_programa():
+    with open("data/predicciones_J2.json", encoding="utf-8") as fh:
+        payload = json.load(fh)
+    assert payload["jornada"] == 2
+    assert payload["programa"]["signos"] == PROGRAMA_J2
+    assert payload["programa"]["nombre"] == "PROGRAMA"
+    # Trazabilidad: de donde sale el boleto.
+    assert payload["fuente"]["repo"] == "Purplerave/PROGRAMAQUINIELA"
+
+    detalle = payload["detalle_programa"]
+    # Contrato P0: exactamente 3 dobles, 8 columnas, 6,00 EUR.
+    dobles = [i + 1 for i, s in enumerate(PROGRAMA_J2[:14]) if len(s) == 2]
+    assert dobles == detalle["dobles"] == [4, 7, 11]
+    assert detalle["columnas"] == 8
+    assert detalle["coste_euros"] == 6.0
+    assert len(detalle["partidos"]) == 14
+
+    # El signo publicado tiene que ser coherente con las probabilidades.
+    for partido in detalle["partidos"]:
+        probs = partido["prob"]
+        assert abs(sum(probs.values()) - 1.0) < 0.01
+        favorito = max(probs, key=probs.get)
+        assert favorito in partido["signo"]
+
+
+def test_ensure_jornada_2_importa_el_boleto_del_programa():
+    conn = sqlite3.connect(":memory:")
+    conn.row_factory = sqlite3.Row
+    ensure_core_tables(conn)
+    ensure_predicciones_unique_index(conn)
+
+    ensure_jornada_2(conn)
+    assert conn.execute("SELECT COUNT(*) FROM resultados WHERE jornada = 2").fetchone()[0] == 15
+
+    rows = conn.execute(
+        "SELECT signo FROM predicciones WHERE jornada = 2 AND user_id = 'programa' ORDER BY partido_id"
+    ).fetchall()
+    assert [row["signo"] for row in rows] == PROGRAMA_J2
+
+    # Idempotente: no duplica.
+    ensure_jornada_2(conn)
+    total = conn.execute("SELECT COUNT(*) FROM predicciones WHERE jornada = 2 AND user_id = 'programa'").fetchone()[0]
+    assert total == 15
+
+
+def test_importador_generico_no_escribe_si_no_hay_fichero():
+    conn = sqlite3.connect(":memory:")
+    conn.row_factory = sqlite3.Row
+    ensure_core_tables(conn)
+    ensure_predicciones_unique_index(conn)
+
+    # No existe data/predicciones_J999.json: no debe inventar nada.
+    assert _import_programa_ticket(conn, 999) == 0
+    assert conn.execute("SELECT COUNT(*) FROM predicciones WHERE jornada = 999").fetchone()[0] == 0
+
+
+def test_motivos_de_la_j2_tienen_15_entradas():
+    path = f"{config.DATA_DIR}/PREDICTION_REASONS.json"
+    with open(path, encoding="utf-8") as fh:
+        reasons = json.load(fh)
+    programa = reasons["2"]["programa"]
+    assert len(programa) == 15
+    assert all(isinstance(item, str) and item.strip() for item in programa)
